# RYVR production settings for docker compose. Copy to .env and fill in every "change-me".

APP_NAME=RYVR
APP_ENV=production
APP_DEBUG=false
# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=https://analytics.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# The bundled Caddy is the only way in, so trust its X-Forwarded-* headers.
TRUSTED_PROXIES=*

# Hostname Caddy serves (and gets a certificate for). Point its DNS at this machine first.
RYVR_DOMAIN=analytics.example.com
ACME_EMAIL=you@example.com

DB_CONNECTION=pgsql
DB_DATABASE=ryvr
DB_USERNAME=ryvr
DB_PASSWORD=change-me

CLICKHOUSE_DATABASE=ryvr
CLICKHOUSE_USERNAME=ryvr
CLICKHOUSE_PASSWORD=change-me

REDIS_CLIENT=phpredis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

# Mail is optional; without it, invitation links are shown in the app to share by hand.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=analytics@example.com
MAIL_FROM_NAME=RYVR

# Header with the real visitor IP when a CDN you control sits in front (e.g. CF-Connecting-IP).
RYVR_CLIENT_IP_HEADER=
RYVR_TRUST_CDN_COUNTRY=true
# Run "php artisan ryvr:geoip:update" once, then keep it fresh monthly.
RYVR_GEOIP_DATABASE=/app/storage/app/geoip/city.mmdb
RYVR_GEOIP_AUTO_UPDATE=true
# Months of raw events to keep (0 = forever).
RYVR_RETENTION_MONTHS=0
RYVR_REGISTRATION=false
RYVR_REQUIRE_EMAIL_VERIFICATION=false
